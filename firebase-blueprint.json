{
  "entities": {
    "product": {
      "title": "Product",
      "description": "A store catalog product",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique product identifier"
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Product title"
        },
        "description": {
          "type": "string",
          "maxLength": 1000,
          "description": "Product details"
        },
        "price": {
          "type": "number",
          "description": "Product unit price"
        },
        "image": {
          "type": "string",
          "description": "URL to the product illustration"
        },
        "category": {
          "type": "string",
          "description": "Product department/category"
        },
        "rating": {
          "type": "number",
          "description": "Average review rating"
        },
        "stock": {
          "type": "number",
          "description": "Units available in inventory"
        }
      },
      "required": ["id", "name", "price", "image", "category", "stock"]
    },
    "order": {
      "title": "Order",
      "description": "A customer purchase order with delivery address and tracking state",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique order tracking code"
        },
        "userId": {
          "type": "string",
          "description": "The customer auth identifier"
        },
        "userName": {
          "type": "string",
          "description": "Full name of the recipient"
        },
        "userEmail": {
          "type": "string",
          "description": "Contact email of the recipient"
        },
        "address": {
          "type": "string",
          "maxLength": 500,
          "description": "Delivery shipping address"
        },
        "phone": {
          "type": "string",
          "maxLength": 20,
          "description": "Recipient phone number"
        },
        "items": {
          "type": "array",
          "description": "List of cart items in the order"
        },
        "totalAmount": {
          "type": "number",
          "description": "Grand total price of order"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "confirmed", "out_for_delivery", "delivered", "cancelled"],
          "description": "Current tracking status of delivery"
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["cash_on_delivery"],
          "description": "Payment method"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Time of order creation"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Time of last status update"
        }
      },
      "required": [
        "id",
        "userId",
        "userName",
        "userEmail",
        "address",
        "phone",
        "items",
        "totalAmount",
        "status",
        "paymentMethod",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "products/{productId}": {
      "schema": "product",
      "description": "E-commerce product inventory catalog"
    },
    "orders/{orderId}": {
      "schema": "order",
      "description": "Store purchase orders with COD tracking"
    }
  }
}
