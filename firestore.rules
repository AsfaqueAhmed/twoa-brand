rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- REUSABLE PRIMITIVES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Only this account may manage the catalog and administer orders.
    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'asfaqueahmedsakkar@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    // Admin has unrestricted read/write on every collection, present and future.
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // --- COLLECTION RULES (non-admin access) ---

    // 1. Products Catalog
    match /products/{productId} {
      allow read: if true; // Storefront catalog is public
    }

    // 1a. Parent Products — pooled per-size stock, referenced by product.parentProductId.
    // Metadata (name, sizeOrder) is admin-only, covered by the blanket isAdmin() rule above.
    match /parentProducts/{parentId} {
      allow read: if true; // storefront needs name/sizeOrder for display

      match /sizeStock/{sizeId} {
        allow read: if true; // storefront needs per-size stock for badges/quantity caps

        // Checkout (signed-in or guest) decrements pooled stock for exactly one
        // size after placing an order — same shape as the legacy
        // products/{id}.stock rule: only the `stock` field, only a non-negative
        // value, and only ever decreasing.
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']) &&
          request.resource.data.stock is number &&
          request.resource.data.stock >= 0 &&
          request.resource.data.stock <= resource.data.stock;
      }
    }

    // 1b. Categories & Subcategories (persisted independently of products)
    match /categories/{categoryId} {
      allow read: if true;
    }

    // 1c. Size Charts (reusable measurement templates, referenced by product.sizeChartId)
    match /sizeCharts/{chartId} {
      allow read: if true;
    }

    // 1e. Coupons (promo codes)
    match /coupons/{couponId} {
      // Public read so the checkout "Active Promotions" panel and code lookup both work.
      allow read: if true;

      // Any customer, signed-in or guest, may increment usageCount by exactly 1
      // when redeeming a coupon at checkout — nothing else about the coupon may
      // change via this path, which is what actually makes this safe to leave
      // open rather than the caller's auth state.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount']) &&
        request.resource.data.usageCount == resource.data.usageCount + 1;
    }

    // 2. Orders Collection
    //
    // Guest checkout has no Firebase Auth identity to check, so a guest order's
    // only "credential" is its own document ID (a long random token generated by
    // generateOrderId() and kept client-side in localStorage — see
    // localStorageGuestOrdersRepository.ts). That's why guest access below is
    // scoped to `get` (fetch-by-known-ID) only, never `list` — `list` would let
    // anyone enumerate every guest order in the collection.
    function isOwnedOrder() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /orders/{orderId} {
      // Signed-in customers can fetch or query their own orders. Guests (and
      // anyone with the link) can fetch a single guest order by its exact ID.
      allow get: if isOwnedOrder() || resource.data.userId == 'guest';
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      // Signed-in users place orders under their own uid; guests place orders
      // explicitly marked 'guest' (never impersonating a real uid).
      allow create: if (isSignedIn() && request.resource.data.userId == request.auth.uid) ||
        (!isSignedIn() && request.resource.data.userId == 'guest');

      // The owner (signed-in, or a guest who knows the order ID) may cancel a
      // pending order, changing only the status field.
      allow update: if (isOwnedOrder() || resource.data.userId == 'guest') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
        request.resource.data.status == 'cancelled';
    }

    // 3. Test Connection
    match /test/{docId} {
      allow read: if true;
    }
  }
}
