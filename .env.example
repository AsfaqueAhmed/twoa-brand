# Firebase client config is read from firebase-applet-config.json (already committed, contains only public client keys).
# TODO(supabase-migration): remove the line above once the Firebase cutover is complete.

# Supabase project URL and anon/publishable key (safe to expose client-side —
# access is enforced by Postgres RLS policies, not by keeping this secret).
# NEXT_PUBLIC_*  vars are inlined at `next build` time (this app is a static
# export), so these must be set wherever you run the build, not just at runtime.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Meta/Facebook Pixel ID (from Events Manager). If unset, the Pixel
# script simply doesn't render — nothing breaks, it just won't track anything.
NEXT_PUBLIC_META_PIXEL_ID=
